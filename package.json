{
  "name": "airfield-brief",
  "version": "1.0.0",
  "description": "PWA de briefing pré-vol VFR (météo, NOTAM, AZBA, cartes) pour un aérodrome — configurable via src/config/club.config.js",
  "productName": "Airfield Brief",
  "author": "Stephanfo",
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\" \"./tests/**/*.{js,vue}\" vitest.config.js",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "data:example": "node scripts/copy-data-examples.mjs",
    "data:examples:build": "node scripts/make-data-examples.mjs"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "@vueuse/core": "^14.2.0",
    "echarts": "^6.0.0",
    "firebase": "^12.7.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.4",
    "quasar": "^2.16.0",
    "register-service-worker": "^1.7.2",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.22",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^2.1.0",
    "@quasar/icongenie": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/eslint-config-prettier": "^10.1.0",
    "autoprefixer": "^10.4.2",
    "dotenv": "^17.2.3",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "happy-dom": "^20.10.1",
    "postcss": "^8.4.14",
    "prettier": "^3.3.3",
    "vite-plugin-checker": "^0.11.0",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.2.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
