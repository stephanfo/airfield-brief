# Firebase Cloud Messaging Configuration
# Pour activer les notifications push, créez un fichier .env à partir de ce template
# et remplissez avec vos vraies clés Firebase

# Obtenez ces valeurs depuis Firebase Console > Project Settings > General
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_VAPID_KEY=your_vapid_key

# Instructions:
# 1. Allez sur https://console.firebase.google.com/
# 2. Créez un nouveau projet ou sélectionnez un projet existant
# 3. Allez dans Project Settings (icône d'engrenage)
# 4. Dans l'onglet "General", scrollez jusqu'à "Your apps"
# 5. Cliquez sur l'icône Web "</>" pour ajouter une app web
# 6. Copiez les valeurs de firebaseConfig dans ce fichier
# 7. Pour la clé VAPID: Project Settings > Cloud Messaging > Web Push certificates
#    Cliquez sur "Generate key pair" si vous n'en avez pas
#    Copiez la clé publique (Key pair) dans FIREBASE_VAPID_KEY
# 8. Renommez ce fichier en .env
# 9. Relancez l'application avec: quasar dev

# ─────────────────────────────────────────────────────────────
# Soumission de REX (FEAT-033)
# ─────────────────────────────────────────────────────────────
# URL publique HTTPS du service web rex-submit (Airfield-Portal-Scripts).
# Injectée au build (PWA compilée) : elle finit en clair dans le bundle servi,
# mais reste hors du dépôt public grâce au .env gitignoré.
REX_SUBMIT_URL=https://<host>/rex-submit/
# Jeton partagé anti-abus (doit correspondre à rexSubmit.submitToken du config.php
# serveur). Ce n'est PAS un secret : le front est téléchargé par le navigateur.
REX_SUBMIT_TOKEN=

# ─────────────────────────────────────────────────────────────
# Déploiement
# ─────────────────────────────────────────────────────────────
# Chemin public de déploiement, injecté au build (publicPath Quasar).
#   /            → site servi à la racine du domaine (cas nominal)
#   /sous-chemin/ → site servi depuis un sous-répertoire (bien garder les deux /)
# Le service worker, lui, se cale automatiquement sur son propre scope : aucun
# chemin n'est écrit en dur.
PUBLIC_PATH=/

# URL publique absolue du site, SANS slash final (ex. https://brief.example.fr).
# Sert à construire l'URL absolue de l'image d'aperçu (og:image) exigée par les
# réseaux sociaux. Facultative : sans elle, l'aperçu de partage n'a pas d'image.
APP_URL=
